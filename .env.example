# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WS_URL=ws://localhost:8080/ws
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
DATABASE_URL=postgres://quizparty:quizparty@127.0.0.1:5432/quizparty_dev
# Optional: enables distributed rate limits / presence
# REDIS_URL=redis://127.0.0.1:6379
# 32+ random bytes, base64url. Required in production.
SERVER_SECRET=dev-only-change-me-dev-only-change-me
TRUST_PROXY_HOPS=0
SERVE_WEB=0
QP_ALLOW_DEV_SEED=1
