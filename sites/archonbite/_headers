# Security and cache headers. Understood by Cloudflare Pages and Netlify as is; for Render Static Sites copy the
# same values into the dashboard (Settings -> Headers) or see DEPLOY.md. No cookies are set anywhere on this site.
#
# CSP in one line: everything comes from this site itself. No inline script or style (all code lives in files), the only
# outside host is the privacy-friendly YouTube embed host, and ONLY when a visitor presses a trailer's play button.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Caching. Pages, CSS, JS and JSON get the host's default (always revalidate), so edits show up at once.
# Only folders of big, rarely-changing files get a long cache. (Several matching rules ADD headers, so the
# catch-all rule above deliberately carries no Cache-Control.)

# Fonts never change: cache for a year.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep their name when they change only if you accept a delay: rename a file when you replace it.
/assets/quiznight/*
  Cache-Control: public, max-age=2592000
/assets/img/*
  Cache-Control: public, max-age=2592000

# Salty Pirate art is meant to be swapped by the owner: short cache so new images show up within the hour.
/assets/salty-pirate/*
  Cache-Control: public, max-age=3600, must-revalidate
