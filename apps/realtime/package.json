    "@quizparty/validation": "workspace:*",
    "fastify": "5.12.5",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
