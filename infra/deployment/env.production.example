# Copy to ".env" next to docker-compose.prod.yml and fill in every line. Never commit the real file.
# Full explanations: docs/DEPLOYMENT.md (section "Environment variables").

# The public address people type, without https:// (DNS must already point at this server).
DOMAIN=quiz.your-domain.example

# Database password: letters and digits only (it goes into a URL). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Long random secret that keys every hash the server stores. Generate: openssl rand -hex 32
# Changing it later signs everybody out and breaks old links: see docs/RUNBOOK.md before touching it.
SERVER_SECRET=

# Protects the /metrics page. Generate: openssl rand -hex 24
METRICS_TOKEN=

# Who becomes administrator on first sign-in (comma separated, your real email addresses).
ADMIN_BOOTSTRAP_EMAILS=

# How sign-in codes are emailed. Either a transactional-mail API (recommended; docs/DEPLOYMENT.md section 5):
#   EMAIL_PROVIDER=resend (or brevo), EMAIL_API_KEY=<key from the provider>, EMAIL_FROM=Name <address@your-verified-domain>
# or a generic webhook that accepts a JSON POST {to, subject, text} (not both).
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# Keys that seal Blind Quiz answers: id:base64key (32 random bytes). Generate: echo "k1:$(openssl rand -base64 32)"
# Leave empty to run without personal quizzes. Back it up separately from the database (docs/BACKUP.md).
BLIND_DATA_KEYS=

# Optional: how long operational records are kept before the maintenance job deletes them. Empty = the defaults
# (sign-in codes 24 hours, dead sessions 7 days, security events and telemetry 180 days, closed rooms 30 days).
# If you change one, change the privacy page text too (packages/i18n/src/legal.ts, docs/PRIVACY.md section 3).
RETENTION_OTP_HOURS=
RETENTION_ACCOUNT_SESSION_DAYS=
RETENTION_SECURITY_EVENT_DAYS=
RETENTION_TELEMETRY_DAYS=
RETENTION_CLOSED_ROOM_DAYS=
